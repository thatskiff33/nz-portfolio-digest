# Copy to `.env` on the server (chmod 600). Never commit `.env`.
# Use hex passwords (`openssl rand -hex 32`) so they are safe inside a database URL.

# Postgres superuser, used only inside the database container.
POSTGRES_ADMIN_PASSWORD=
# The app's own least-privilege database login, also used for backups.
APP_DB_PASSWORD=

# Where nightly backups are written on the host (create it first), and how many days to keep.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Owner of the backup files on the host (run `id -u` and `id -g` on the server).
BACKUP_UID=1000
BACKUP_GID=1000

# Optional. Currency every value is reported in (new portfolios default to it) and the
# timezone used for "today".
# BASE_CURRENCY=NZD
# TIMEZONE=Pacific/Auckland

# Only needed when running the CLI outside Docker (e.g. local development):
# DATABASE_URL=postgresql+psycopg://portfolio:<APP_DB_PASSWORD>@localhost:5432/portfolio

# Optional Akahu confirmation sync. Create a Personal App at https://my.akahu.nz,
# connect your investment provider and copy the app token and personal user token.
# See https://developers.akahu.nz/docs/personal-apps and docs/AKAHU.md.
# Tokens belong only in env/.env on your server, never in commands or git.
AKAHU_APP_TOKEN=
AKAHU_USER_TOKEN=
# Optional JSON array restricting which investment accounts belong to this portfolio.
# Defaults to all investment accounts; set explicitly when you have multiple portfolios.
AKAHU_ACCOUNT_IDS=[]
# Optional full Uptime Kuma Push monitor URL, including its token (treat as a secret).
UPTIME_KUMA_PUSH_URL=

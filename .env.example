# Copy to `.env` on the server (chmod 600). Never commit `.env`.
# Use hex passwords (`openssl rand -hex 32`) so they are safe inside a database URL.

# Postgres superuser, used only inside the database container.
POSTGRES_ADMIN_PASSWORD=
# The app's own least-privilege database login, also used for backups.
APP_DB_PASSWORD=

# Where nightly backups are written on the host (create it first), and how many days to keep.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Owner of the backup files on the host (run `id -u` and `id -g` on the server).
BACKUP_UID=1000
BACKUP_GID=1000

# Optional. Currency every value is reported in (new portfolios default to it) and the
# timezone used for "today".
# BASE_CURRENCY=NZD
# TIMEZONE=Pacific/Auckland

# Optional market-data providers. Yahoo is free and keyless; Frankfurter supplies an ECB
# fallback for exchange rates. Paid providers can be added behind the source interfaces.
# PRICE_SOURCE=yahoo
# FX_SOURCES=yahoo,frankfurter

# Only needed when running the CLI outside Docker (e.g. local development):
# DATABASE_URL=postgresql+psycopg://portfolio:<APP_DB_PASSWORD>@localhost:5432/portfolio

# ASB Securities Gmail feed. Create a Google OAuth desktop-app client, put contract-note
# emails under one dedicated label, then run `portfolio-digest gmail authorise`. Copy the
# refresh token it writes into this private .env file. The app requests gmail.readonly only.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_LABEL=ASB contract notes

# Outgoing digest email (separate from Gmail's read-only ASB import OAuth settings).
MAILER=gmail
MAIL_FROM=
MAIL_OWNER=
# Gmail: enable 2-Step Verification, then create an app password (not your login password).
GMAIL_SMTP_USERNAME=
GMAIL_APP_PASSWORD=
# Postmark: verified sender and Server API token.
# POSTMARK_SERVER_TOKEN=
# SES: SMTP credentials are different from IAM API access keys.
# AWS_REGION=ap-southeast-2
# SES_SMTP_USERNAME=
# SES_SMTP_PASSWORD=
# SES uses the API instead when AWS_ACCESS_KEY_ID is supplied. Needs ses:SendRawEmail.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Generic SMTP: STARTTLS by default, or ssl for implicit TLS (normally port 465).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
